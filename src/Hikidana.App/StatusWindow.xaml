<Window x:Class="Hikidana.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hikidana"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="Assets/Hikidana.ico">
  <Grid Margin="32">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
        <Canvas Width="16" Height="16">
          <Path x:Name="Logo"
                StrokeThickness="1.2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Data="M 2.5,6 L 13.5,6 A 1,1 0 0 1 14.5,7 L 14.5,12.5 A 1,1 0 0 1 13.5,13.5 L 2.5,13.5 A 1,1 0 0 1 1.5,12.5 L 1.5,7 A 1,1 0 0 1 2.5,6 Z M 6.2,9.7 L 9.8,9.7 M 3.5,6 L 3.5,3.5 A 1,1 0 0 1 4.5,2.5 L 11.5,2.5 A 1,1 0 0 1 12.5,3.5 L 12.5,6" />
        </Canvas>
      </Viewbox>
      <TextBlock Text="Hikidana" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
      <TextBlock x:Name="StageText" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" />
      <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" Opacity="0.7" />
    </StackPanel>
  </Grid>
</Window>
