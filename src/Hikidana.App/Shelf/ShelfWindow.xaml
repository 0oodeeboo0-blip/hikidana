<Window x:Class="Hikidana.App.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hikidana.App.Shelf"
        Title="Hikidana"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource Hkd.PanelBackground}"
        Foreground="{DynamicResource Hkd.TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">
  <!--
    棚。作業中のアプリからフォーカスを奪わない（WS_EX_NOACTIVATE。ShelfWindow.xaml.cs）。
    置き場所と大きさは ShelfController が本当の画素で決める。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 上の帯 -->
    <DockPanel Grid.Row="0" Margin="16,10,8,8" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ToggleButton x:Name="KeepOpenToggle" Style="{StaticResource IconToggle}" Content="&#xE718;"
                      ToolTip="開いたままにする（貼り付けても、ほかをクリックしても閉じない）" Click="KeepOpen_Click" />
        <ToggleButton x:Name="PauseToggle" Style="{StaticResource IconToggle}" Content="&#xE769;"
                      ToolTip="記録を止める" Click="Pause_Click" />
        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="その他" Click="More_Click">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="しまってある場所を開く" Click="OpenData_Click" />
              <MenuItem Header="記録（ログ）の場所を開く" Click="OpenLogs_Click" />
              <Separator />
              <MenuItem Header="Hikidana を終了" Click="Quit_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="閉じる" Click="Close_Click" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Hikidana" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="CountText" Margin="8,1,0,0" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource Hkd.TextTertiary}" />
      </StackPanel>
    </DockPanel>

    <!-- 記録を止めているとき -->
    <Border x:Name="PausedBanner" Grid.Row="1" Margin="12,0,12,8" Padding="12,7,6,7" CornerRadius="6"
            Background="{DynamicResource Hkd.CautionBackground}" Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="再開" Click="Resume_Click" />
        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,10,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource Hkd.Caution}" />
        <TextBlock Text="記録を止めています。コピーしても棚に入りません。" TextWrapping="Wrap" FontSize="12"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- カード -->
    <ItemsControl x:Name="CardList" Grid.Row="2" Focusable="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer CanContentScroll="True" Focusable="False" Padding="12,0,12,4"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:ClipItem}">
          <Button Style="{StaticResource CardButton}" Margin="0,0,0,8" Click="Card_Click"
                  ToolTip="{Binding PasteToolTip}" ToolTipService.InitialShowDelay="1500">
            <StackPanel>
              <!-- 上の行: 種類・アプリ・いつ。マウスを乗せると操作のボタン -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Margin="0,1,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Hkd.TextTertiary}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,5,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource Hkd.Accent}"
                             Visibility="{Binding Pinned, Converter={StaticResource Visible}}" />
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource Hkd.TextTertiary}">
                    <Run Text="{Binding KindName, Mode=OneWay}" /><Run Text="・" /><Run Text="{Binding Meta, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,-6,-4,-6">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Opacity" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE8C8;"
                          ToolTip="コピーだけする" Click="Copy_Click" />
                  <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE74D;"
                          ToolTip="消す" Click="Delete_Click" />
                  <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="{Binding PinGlyph}"
                          ToolTip="{Binding PinToolTip}" Click="Pin_Click" />
                </StackPanel>
              </Grid>

              <!-- 画像 -->
              <Border HorizontalAlignment="Left" Background="{DynamicResource Hkd.ImageBackdrop}"
                      Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                <Image Source="{Binding Thumbnail}" Width="{Binding ImageDisplayWidth}" Height="{Binding ImageDisplayHeight}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>

              <!-- テキスト・リンク・ファイルの名前 -->
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="95"
                         LineHeight="19" LineStackingStrategy="BlockLineHeight"
                         Visibility="{Binding IsPlainText, Converter={StaticResource Visible}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Hkd.TextPrimary}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLink}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Hkd.AccentText}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- コードと表（等幅） -->
              <Border CornerRadius="4" Padding="9,7" Background="{DynamicResource Hkd.ImageBackdrop}"
                      Visibility="{Binding IsMonospace, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="85"
                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
              </Border>

              <!-- 色 -->
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsColor, Converter={StaticResource Visible}}">
                <Border Width="30" Height="30" CornerRadius="4" Background="{Binding Swatch}"
                        BorderBrush="{DynamicResource Hkd.CardBorderHover}" BorderThickness="1" />
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CodeFont}" FontSize="13"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>

              <!-- 補足（大きさ、行と列の数、ホストなど） -->
              <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Hkd.TextTertiary}"
                         Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 空のとき -->
    <StackPanel x:Name="EmptyState" Grid.Row="2" Margin="36,0" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Hkd.TextTertiary}" />
      <TextBlock Text="まだ何もありません" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
      <TextBlock Text="コピーしたものや撮ったスクリーンショットが、ここに入ります。クリックすると、作業中のアプリに貼り付けます。"
                 TextWrapping="Wrap" TextAlignment="Center" FontSize="12" LineHeight="18"
                 Foreground="{DynamicResource Hkd.TextSecondary}" />
    </StackPanel>
  </Grid>
</Window>
