<Window x:Class="Hikidana.App.Shelf.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hikidana の知らせ"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource Hkd.InfoBackground}"
        Foreground="{DynamicResource Hkd.TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">
  <!--
    貼り付けた・コピーした・貼れなかった、などの短い知らせ。しばらくすると消える（マウスを乗せている間は消えない）。
    大きさは中身を測って ToastWindow.xaml.cs で決める（SizeToContent を使うと、最初に出したときに中身が描かれないことがあった）。
  -->
  <Border x:Name="Card" MinWidth="220" MaxWidth="400" Padding="14,11,12,11">
    <DockPanel>
      <TextBlock x:Name="IconText" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="16"
                 Margin="0,1,12,0" VerticalAlignment="Top" />
      <Button x:Name="ActionButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}"
              Margin="10,-5,0,-5" VerticalAlignment="Center" Visibility="Collapsed" Click="Action_Click" />
      <TextBlock x:Name="Message" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19"
                 LineStackingStrategy="BlockLineHeight" />
    </DockPanel>
  </Border>
</Window>
