<Application x:Class="Hikidana.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <!--
    色は Theme/Palette.cs が Hkd. で始まる名前で入れる（ライト・ダークと Windows のアクセント色に合わせて入れ替わる）。
    ここでは、それを使う見た目だけを決める。
  -->
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI, Yu Gothic UI, Meiryo UI</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, BIZ UDGothic, MS Gothic</FontFamily>

    <!-- 棚のカード。押すと貼り付ける -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Hkd.CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hkd.CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Hkd.TextPrimary}" />
      <Setter Property="Padding" Value="12,9,10,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <!--
              マウスを乗せたときの色は、ボタンそのものの色として変える（中の Frame を直接変えない）。
              こうすると、カードの Style の DataTrigger（選んでいる・キーボードで選んでいる）のほうが強く、乗せても選んだ色のままになる。
            -->
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hkd.CardBackgroundHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Hkd.CardBorderHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hkd.CardBackgroundPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      記号だけの小さなボタン（ピン留め・コピー・消す・閉じるなど）。記号のフォントは中身（ContentPresenter）にだけ付ける。
      ボタンそのものに付けると、ボタンのメニューや説明の吹き出しまで記号のフォントになり、日本語が四角（□）になる。
    -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hkd.TextSecondary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource IconFont}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtleHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Hkd.TextPrimary}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtlePressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 入り切りする記号のボタン（棚を開いたままにする・記録を止める） -->
    <Style x:Key="IconToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hkd.TextSecondary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontFamily="{StaticResource IconFont}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtleHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtlePressed}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Hkd.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 絞り込みの丸いボタン（すべて・画像・テキスト…）。どれか 1 つだけ選ばれる -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Hkd.TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hkd.CardBorderHover}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="9,3,9,4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtleHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.Accent}" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Hkd.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Hkd.OnAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- キーボードで動かしたときに出す、フォーカスの枠（Windows 11 と同じく、まわりに 2 画素の線） -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource Hkd.FocusStroke}"
                    SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      入り切りのスイッチ（Windows 11 の設定と同じ形）。CheckBox に付ける。左に「オン」「オフ」を出し、つまみは滑って動く。
      押している間は、つまみが内側へ少し伸びる。
    -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Hkd.TextPrimary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="{TemplateBinding Background}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="StateText" Grid.Column="0" Text="オフ" MinWidth="28" Margin="0,0,12,1"
                         TextAlignment="Right" VerticalAlignment="Center" />
              <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource Hkd.ToggleFillOff}" BorderBrush="{DynamicResource Hkd.ControlStrongStroke}" />
                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource Hkd.ToggleKnobOff}">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="0" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="StateText" Property="Text" Value="オン" />
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Hkd.Accent}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Hkd.Accent}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Hkd.OnAccent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
                <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Hkd.ToggleFillOffHover}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Hkd.AccentHover}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Hkd.AccentHover}" />
              </MultiTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Knob" Property="Width" Value="17" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsPressed" Value="True" />
                  <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,0,0" />
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Hkd.AccentPressed}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Hkd.AccentPressed}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- アクセント色で塗った、いちばん大事なボタン（まとめて貼り付けなど） -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Hkd.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Hkd.OnAccent}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,5,12,6" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.AccentHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.AccentPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文字のボタン（知らせの「元に戻す」など） -->
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Hkd.AccentText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtleHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hkd.SubtlePressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
