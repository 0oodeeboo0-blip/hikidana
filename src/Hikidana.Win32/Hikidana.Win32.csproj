<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows の API（クリップボード、キー入力、ウインドウ、プロセス）を直接呼ぶ部分。
    net10.0 にしてあるので、作業環境（Linux）でもビルドだけはできる（動かすのは Windows）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hikidana.Win32</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hikidana.Core\Hikidana.Core.csproj" />
  </ItemGroup>

</Project>
