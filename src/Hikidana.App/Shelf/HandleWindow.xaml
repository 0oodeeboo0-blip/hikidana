<Window x:Class="Hikidana.App.Shelf.HandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hikidana の取っ手"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True">
  <!--
    画面の端の取っ手。ふだんは細い線だけが見えて、その線のところだけがマウスを受ける（ほかは透けて下のウインドウに届く）。
    マウスを乗せると、つまみが出る。クリックで棚を開き、ドラッグで端に沿って動かせる。
  -->
  <Grid x:Name="Root"
        MouseEnter="Root_MouseEnter"
        MouseLeave="Root_MouseLeave"
        MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp"
        LostMouseCapture="Root_LostMouseCapture">
    <Border x:Name="HitArea" Background="#01000000">
      <Border x:Name="Strip" CornerRadius="2" Background="{DynamicResource Hkd.Accent}"
              BorderBrush="{DynamicResource Hkd.HandleStripEdge}" BorderThickness="0.5" />
    </Border>
    <Border x:Name="Tab" Visibility="Collapsed"
            Background="{DynamicResource Hkd.HandleTab}" BorderBrush="{DynamicResource Hkd.PanelBorder}"
            ToolTip="クリックで棚を開きます。ドラッグすると、端に沿って動かせます。">
      <TextBlock x:Name="Chevron" FontFamily="{StaticResource IconFont}" FontSize="14"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Hkd.Accent}" />
    </Border>
  </Grid>
</Window>
