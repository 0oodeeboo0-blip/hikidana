<Window x:Class="Hikidana.App.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hikidana の設定"
        Width="660"
        Height="800"
        MinWidth="540"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Hikidana.ico"
        Background="{DynamicResource Hkd.SettingsBackground}"
        Foreground="{DynamicResource Hkd.TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Language="ja-JP"
        UseLayoutRounding="True">
  <!--
    設定の画面（Windows 11 の設定アプリと同じ作り: まとまりの見出しと、1 つずつの設定のカード）。
    変えたらすぐ棚に反映して保存する（「OK」や「適用」は無い）。決めるのは ISettingsHost（ShelfController）。
    背景は、Windows 11 なら Mica（SettingsWindow.xaml.cs）。
    Language を ja-JP にして、日本語が中国語の字形で出ないようにする。
  -->
  <Window.Resources>
    <!-- 標準の部品（Fluent の見た目）でも、字は日本語のフォントで出す -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <!-- まとまりの見出し -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,28,0,8" />
    </Style>

    <!-- 1 つの設定の名前 -->
    <Style x:Key="SettingName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 設定の説明（小さく、少し薄く） -->
    <Style x:Key="SettingHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Hkd.TextSecondary}" />
    </Style>

    <!-- 設定のカード -->
    <Style x:Key="SettingCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Hkd.CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hkd.CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,13,16,13" />
      <Setter Property="MinHeight" Value="66" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- カードの左の記号 -->
    <Style x:Key="SettingIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Margin" Value="2,0,18,0" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>

    <!-- 右・左・上・下のボタン（棚の絞り込みと同じ丸いボタン） -->
    <Style x:Key="EdgeChip" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>

    <!-- 画面の図の、小さな棚の中のカード -->
    <Style x:Key="MiniCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Background" Value="{DynamicResource Hkd.MiniCard}" />
    </Style>
  </Window.Resources>

  <ScrollViewer x:Name="Scroller" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Page" Margin="28,14,28,28" MaxWidth="880">
      <TextBlock Text="設定" FontSize="28" FontWeight="SemiBold" Margin="2,0,0,0" />

      <!-- 棚の位置 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="棚の位置" Margin="2,18,0,8" />
      <Border Style="{StaticResource SettingCard}" Padding="18,18,18,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 画面の図。端の近くをクリックすると、その端に棚を出す（マウスを乗せると、出る場所を薄く見せる） -->
          <StackPanel Grid.Column="0" Width="252" VerticalAlignment="Center">
            <Grid Height="160">
              <!-- 画面の枠（ふち）。中の Canvas が画面で、その中に壁紙・タスクバー・棚・取っ手を描く -->
              <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="4" CornerRadius="8" BorderThickness="1"
                      Background="{DynamicResource Hkd.ScreenBezel}" BorderBrush="{DynamicResource Hkd.ScreenBezelEdge}">
                <Canvas x:Name="Diagram" Width="240" Height="135"
                        Background="Transparent" Cursor="Hand" ClipToBounds="True"
                        ToolTip="クリックした端に、棚を出します"
                        MouseMove="Diagram_MouseMove" MouseLeave="Diagram_MouseLeave" MouseLeftButtonUp="Diagram_MouseLeftButtonUp">
                <Border x:Name="ScreenFrame" CornerRadius="3" Background="{DynamicResource Hkd.ScreenWallpaper}" />
                <Border x:Name="TaskbarBar" Background="{DynamicResource Hkd.ScreenTaskbar}" />
                <Rectangle x:Name="GhostPanel" RadiusX="3" RadiusY="3" StrokeThickness="1.5" StrokeDashArray="3 2"
                           Visibility="Collapsed" Fill="{DynamicResource Hkd.GhostFill}" Stroke="{DynamicResource Hkd.Accent}" />
                <Border x:Name="MiniPanel" CornerRadius="3" BorderThickness="1" ClipToBounds="True"
                        Background="{DynamicResource Hkd.MiniPanel}" BorderBrush="{DynamicResource Hkd.CardBorderHover}">
                  <StackPanel Margin="3.5,4,3.5,0">
                    <Border Style="{StaticResource MiniCard}" Width="16" Height="3" HorizontalAlignment="Left" Margin="0,0,0,3" />
                    <Border Style="{StaticResource MiniCard}" Height="15" />
                    <Border Style="{StaticResource MiniCard}" Height="8" />
                    <Border Style="{StaticResource MiniCard}" Height="8" />
                    <Border Style="{StaticResource MiniCard}" Height="15" />
                    <Border Style="{StaticResource MiniCard}" Height="8" />
                    <Border Style="{StaticResource MiniCard}" Height="8" />
                    <Border Style="{StaticResource MiniCard}" Height="15" />
                    <Border Style="{StaticResource MiniCard}" Height="8" />
                  </StackPanel>
                </Border>
                <Border x:Name="MiniHandle" CornerRadius="2" Background="{DynamicResource Hkd.Accent}" />
                </Canvas>
              </Border>
            </Grid>
            <!-- 画面の台 -->
            <Border Width="28" Height="10" Background="{DynamicResource Hkd.ScreenStand}" HorizontalAlignment="Center" />
            <Border Width="78" Height="5" CornerRadius="2.5" Background="{DynamicResource Hkd.ScreenStand}" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="棚を出す端" />
            <TextBlock Style="{StaticResource SettingHint}"
                       Text="図の端の近くをクリックするか、下のボタンで選びます。取っ手と棚は、すぐにそこへ動きます。" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <RadioButton x:Name="EdgeRight" Style="{StaticResource EdgeChip}" GroupName="Edge" Content="右"
                           ToolTip="画面の右の端に出す" Checked="Edge_Checked" />
              <RadioButton x:Name="EdgeLeft" Style="{StaticResource EdgeChip}" GroupName="Edge" Content="左"
                           ToolTip="画面の左の端に出す" Checked="Edge_Checked" />
              <RadioButton x:Name="EdgeTop" Style="{StaticResource EdgeChip}" GroupName="Edge" Content="上"
                           ToolTip="画面の上の端に出す" Checked="Edge_Checked" />
              <RadioButton x:Name="EdgeBottom" Style="{StaticResource EdgeChip}" GroupName="Edge" Content="下"
                           ToolTip="画面の下の端に出す" Checked="Edge_Checked" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- モニターが 2 つ以上あるときだけ出す -->
      <Border x:Name="MonitorCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
        <DockPanel>
          <ComboBox x:Name="MonitorBox" DockPanel.Dock="Right" MinWidth="230" VerticalAlignment="Center"
                    AutomationProperties.Name="出す画面" SelectionChanged="Monitor_SelectionChanged" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE7F4;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="出す画面" />
            <TextBlock Style="{StaticResource SettingHint}" Text="どの画面の端に、棚を出すか。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <Button x:Name="CenterHandleButton" DockPanel.Dock="Right" MinWidth="128" VerticalAlignment="Center"
                  Content="真ん中に戻す" Click="CenterHandle_Click" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE76F;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="取っ手の位置" />
            <TextBlock Style="{StaticResource SettingHint}" Text="取っ手は、ドラッグすると端に沿って動かせます。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 開き方 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="開き方" />
      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE7C9;" VerticalAlignment="Top" Margin="2,1,18,0" />
          <StackPanel>
            <TextBlock Style="{StaticResource SettingName}" Text="棚を開くとき" />
            <RadioButton x:Name="OpenByClick" GroupName="OpenMode" Margin="0,10,0,0"
                         Content="取っ手をクリックしたとき" Checked="OpenMode_Checked" />
            <RadioButton x:Name="OpenByHover" GroupName="OpenMode" Margin="0,8,0,2" Checked="OpenMode_Checked">
              <StackPanel>
                <TextBlock Text="取っ手にマウスを乗せたとき" />
                <TextBlock Style="{StaticResource SettingHint}" Text="棚からマウスを離すと閉じます。" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <CheckBox x:Name="CloseAfterPasteSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                    AutomationProperties.Name="貼り付けたら棚を閉じる" Click="CloseAfterPaste_Click" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE77F;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="貼り付けたら棚を閉じる" />
            <TextBlock Style="{StaticResource SettingHint}" Text="オフにすると、棚を開いたまま続けて貼り付けられます。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 見た目 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="見た目" />
      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                    AutomationProperties.Name="色" SelectionChanged="Theme_SelectionChanged">
            <ComboBoxItem Content="Windows に合わせる" Tag="system" />
            <ComboBoxItem Content="ライト" Tag="light" />
            <ComboBoxItem Content="ダーク" Tag="dark" />
          </ComboBox>
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE790;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="色" />
            <TextBlock Style="{StaticResource SettingHint}" Text="棚とこの画面を、明るい色か暗い色にします。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 記録 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="記録" />
      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <ComboBox x:Name="MaxItemsBox" DockPanel.Dock="Right" MinWidth="140" VerticalAlignment="Center"
                    AutomationProperties.Name="しまっておく数" SelectionChanged="MaxItems_SelectionChanged" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE8F1;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="しまっておく数" />
            <TextBlock Style="{StaticResource SettingHint}" Text="これより多くなると、古いものから消えます。ピン留めしたものは数に入らず、消えません。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <CheckBox x:Name="MoveToTopSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                    AutomationProperties.Name="貼り付けたものを上へ動かす" Click="MoveToTop_Click" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE74A;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="貼り付けたものを上へ動かす" />
            <TextBlock Style="{StaticResource SettingHint}" Text="貼り付けたりコピーしたりしたカードを、棚のいちばん上に動かします。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <CheckBox x:Name="PausedSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                    AutomationProperties.Name="記録を止める" Click="Paused_Click" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE769;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="記録を止める" />
            <TextBlock Style="{StaticResource SettingHint}" Text="止めている間は、コピーしたものもスクリーンショットも、棚に入りません。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 起動 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="起動" />
      <Border Style="{StaticResource SettingCard}">
        <DockPanel>
          <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                    AutomationProperties.Name="Windows にサインインしたら起動する" Click="Startup_Click" />
          <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE7E8;" />
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingName}" Text="Windows にサインインしたら起動する" />
            <TextBlock Style="{StaticResource SettingHint}" Text="パソコンを使い始めると、自動で Hikidana が動き始めます。" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- このアプリについて -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="このアプリについて" />
      <Border Style="{StaticResource SettingCard}" Padding="16,14,16,10">
        <StackPanel>
          <DockPanel>
            <Image x:Name="AppIcon" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Hikidana" FontWeight="SemiBold" />
              <TextBlock x:Name="VersionText" Style="{StaticResource SettingHint}" Margin="0,0,0,0" />
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="46,12,0,0">
            <Button Content="しまってある場所を開く" Margin="0,0,8,6" Padding="12,5" Click="OpenData_Click" />
            <Button Content="記録（ログ）の場所を開く" Margin="0,0,8,6" Padding="12,5" Click="OpenLogs_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
