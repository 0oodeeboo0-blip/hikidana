<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF のアプリ。画面と Windows に固有の部分だけを置く。発行（publish）では .NET ごと 1 つの exe にまとめる -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Hikidana</AssemblyName>
    <RootNamespace>Hikidana.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Hikidana.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: Fluent（ThemeMode）がまだ試験的という知らせ -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Hikidana.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hikidana.Core\Hikidana.Core.csproj" />
  </ItemGroup>

</Project>
