<Window x:Class="Hikidana.App.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hikidana.App.Shelf"
        Title="Hikidana"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource Hkd.PanelBackground}"
        Foreground="{DynamicResource Hkd.TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragEnter="Window_DragOver"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
  <!--
    棚。作業中のアプリからフォーカスを奪わない（WS_EX_NOACTIVATE。ShelfWindow.xaml.cs）。
    置き場所と大きさは ShelfController が本当の画素で決める。
  -->
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 上の帯 -->
    <DockPanel Grid.Row="0" Margin="16,10,8,8" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ToggleButton x:Name="KeepOpenToggle" Style="{StaticResource IconToggle}" Content="&#xE718;"
                      ToolTip="開いたままにする（貼り付けても、ほかをクリックしても閉じない）" Click="KeepOpen_Click" />
        <ToggleButton x:Name="PauseToggle" Style="{StaticResource IconToggle}" Content="&#xE769;"
                      ToolTip="記録を止める" Click="Pause_Click" />
        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="その他" Click="More_Click">
          <Button.ContextMenu>
            <ContextMenu FontFamily="{StaticResource UiFont}" Opened="MoreMenu_Opened">
              <MenuItem x:Name="SettingsItem" Header="設定" Click="Settings_Click" />
              <Separator />
              <MenuItem x:Name="OpenOnHoverItem" Header="マウスを乗せるだけで開く" IsCheckable="True" Click="OpenOnHover_Click" />
              <Separator />
              <MenuItem x:Name="ClearScreenshotsItem" Header="ピン留め以外のスクリーンショットを消す" Click="ClearScreenshots_Click" />
              <MenuItem x:Name="ClearAllItem" Header="ピン留め以外をすべて消す" Click="ClearAll_Click" />
              <Separator />
              <MenuItem Header="しまってある場所を開く" Click="OpenData_Click" />
              <MenuItem Header="記録（ログ）の場所を開く" Click="OpenLogs_Click" />
              <Separator />
              <MenuItem Header="Hikidana を終了" Click="Quit_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="閉じる" Click="Close_Click" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Hikidana" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="CountText" Margin="8,1,0,0" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource Hkd.TextTertiary}" />
      </StackPanel>
    </DockPanel>

    <!-- 検索と絞り込み。検索の欄をクリックしたときだけ、キーボードを受け取る（ShelfWindow.xaml.cs） -->
    <StackPanel Grid.Row="1" Margin="12,0,12,8">
      <Grid>
        <TextBox x:Name="SearchBox" FontSize="13" Padding="30,5,30,6" VerticalContentAlignment="Center"
                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource Hkd.TextTertiary}" />
        <TextBlock x:Name="SearchPlaceholder" Text="検索（クリックして入力）" FontSize="13" Margin="31,0,0,1"
                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource Hkd.TextTertiary}" />
        <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,4,0" Visibility="Collapsed"
                ToolTip="検索をやめる" Click="ClearSearch_Click" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="Filter" Content="すべて" IsChecked="True" Checked="Filter_Checked" />
        <RadioButton x:Name="FilterImages" Style="{StaticResource Chip}" GroupName="Filter" Content="画像" Checked="Filter_Checked" />
        <RadioButton x:Name="FilterText" Style="{StaticResource Chip}" GroupName="Filter" Content="テキスト" Checked="Filter_Checked" />
        <RadioButton x:Name="FilterLinks" Style="{StaticResource Chip}" GroupName="Filter" Content="リンク" Checked="Filter_Checked" />
        <RadioButton x:Name="FilterFiles" Style="{StaticResource Chip}" GroupName="Filter" Content="ファイル" Checked="Filter_Checked" />
        <RadioButton x:Name="FilterPinned" Style="{StaticResource Chip}" GroupName="Filter" Checked="Filter_Checked"
                     ToolTip="ピン留めしたものだけ">
          <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,0,0" />
        </RadioButton>
      </StackPanel>
    </StackPanel>

    <!-- 記録を止めているとき -->
    <Border x:Name="PausedBanner" Grid.Row="2" Margin="12,0,12,8" Padding="12,7,6,7" CornerRadius="6"
            Background="{DynamicResource Hkd.CautionBackground}" Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="再開" Click="Resume_Click" />
        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,10,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource Hkd.Caution}" />
        <TextBlock Text="記録を止めています。コピーしても棚に入りません。" TextWrapping="Wrap" FontSize="12"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- カード -->
    <ItemsControl x:Name="CardList" Grid.Row="3" Focusable="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer CanContentScroll="True" Focusable="False" Padding="12,0,12,4"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:ClipItem}">
          <Button Margin="0,0,0,8" Click="Card_Click"
                  PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseMove="Card_PreviewMouseMove"
                  AutomationProperties.AutomationId="{Binding Clip.Id}"
                  ToolTip="{Binding PasteToolTip}" ToolTipService.InitialShowDelay="1500">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Hkd.Accent}" />
                    <Setter Property="Background" Value="{DynamicResource Hkd.CardBackgroundHover}" />
                  </DataTrigger>
                  <!-- まとめて貼るために選んだもの -->
                  <DataTrigger Binding="{Binding IsPicked}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Hkd.Accent}" />
                    <Setter Property="Background" Value="{DynamicResource Hkd.AccentSoft}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Button.ContextMenu>
              <ContextMenu FontFamily="{StaticResource UiFont}">
                <MenuItem Header="貼り付け" FontWeight="SemiBold" Click="MenuPaste_Click">
                  <MenuItem.Icon>
                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding AlternatePasteText}" Click="MenuAlternatePaste_Click"
                          Visibility="{Binding HasAlternatePaste, Converter={StaticResource Visible}}">
                  <MenuItem.Icon>
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="コピーだけする" Click="MenuCopy_Click">
                  <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding PinMenuText}" Click="MenuPin_Click">
                  <MenuItem.Icon>
                    <TextBlock Text="{Binding PinGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="名前を付けて保存..." Click="MenuSave_Click"
                          Visibility="{Binding CanSave, Converter={StaticResource Visible}}">
                  <MenuItem.Icon>
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="消す" Click="MenuDelete_Click">
                  <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel>
              <!-- 上の行: 種類・アプリ・いつ。マウスを乗せると操作のボタン -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Margin="0,1,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Hkd.TextTertiary}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,5,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource Hkd.Accent}"
                             Visibility="{Binding Pinned, Converter={StaticResource Visible}}" />
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             Foreground="{DynamicResource Hkd.TextTertiary}">
                    <Run Text="{Binding KindName, Mode=OneWay}" /><Run Text="・" /><Run Text="{Binding Meta, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <!-- 選んだ順の番号 -->
                <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11" Margin="4,-4,0,-4"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Hkd.Accent}"
                        Visibility="{Binding IsPicked, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding PickOrder}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Hkd.OnAccent}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,-6,-4,-6">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Opacity" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE8C8;"
                          ToolTip="コピーだけする" Click="Copy_Click" />
                  <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE74D;"
                          ToolTip="消す" Click="Delete_Click" />
                  <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="{Binding PinGlyph}"
                          ToolTip="{Binding PinToolTip}" Click="Pin_Click" />
                </StackPanel>
              </Grid>

              <!-- 画像 -->
              <Border HorizontalAlignment="Left" Background="{DynamicResource Hkd.ImageBackdrop}"
                      Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                <Image Source="{Binding Thumbnail}" Width="{Binding ImageDisplayWidth}" Height="{Binding ImageDisplayHeight}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>

              <!-- テキスト・リンク・ファイルの名前 -->
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="95"
                         LineHeight="19" LineStackingStrategy="BlockLineHeight"
                         Visibility="{Binding IsPlainText, Converter={StaticResource Visible}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Hkd.TextPrimary}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLink}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Hkd.AccentText}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- コードと表（等幅） -->
              <Border CornerRadius="4" Padding="9,7" Background="{DynamicResource Hkd.ImageBackdrop}"
                      Visibility="{Binding IsMonospace, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="85"
                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
              </Border>

              <!-- 色 -->
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsColor, Converter={StaticResource Visible}}">
                <Border Width="30" Height="30" CornerRadius="4" Background="{Binding Swatch}"
                        BorderBrush="{DynamicResource Hkd.CardBorderHover}" BorderThickness="1" />
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CodeFont}" FontSize="13"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>

              <!-- 補足（大きさ、行と列の数、ホストなど） -->
              <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Hkd.TextTertiary}"
                         Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- まとめて貼る: カードを選んでいる間だけ出す -->
    <Border x:Name="SelectionBar" Grid.Row="4" Margin="12,0,12,12" Padding="12,8,6,8" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource Hkd.CardBackgroundHover}" BorderBrush="{DynamicResource Hkd.Accent}" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="ClearPicksButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                ToolTip="選ぶのをやめる" Click="ClearPicks_Click" />
        <Button x:Name="DeletePickedButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;"
                ToolTip="選んだものを消す" Click="DeletePicked_Click" />
        <Button x:Name="PastePickedButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                Content="まとめて貼り付け" Click="PastePicked_Click" />
        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="SelectionText" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="クリックで選ぶ・外す" FontSize="11" Foreground="{DynamicResource Hkd.TextSecondary}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ほかのアプリからドラッグしてきたとき -->
    <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="5" Margin="8" CornerRadius="8" Visibility="Collapsed"
            Background="{DynamicResource Hkd.PanelBackground}" BorderBrush="{DynamicResource Hkd.Accent}" BorderThickness="2"
            IsHitTestVisible="False">
      <StackPanel VerticalAlignment="Center" Margin="24,0">
        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Hkd.Accent}" />
        <TextBlock Text="ここに置くと、棚にしまえます" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <!-- 検索や絞り込みで、何も見つからないとき -->
    <StackPanel x:Name="NoMatchState" Grid.Row="3" Margin="36,40,36,0" VerticalAlignment="Top" Visibility="Collapsed">
      <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Hkd.TextTertiary}" />
      <TextBlock Text="見つかりませんでした" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>

    <!-- 空のとき -->
    <StackPanel x:Name="EmptyState" Grid.Row="3" Margin="36,0" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Hkd.TextTertiary}" />
      <TextBlock Text="まだ何もありません" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
      <TextBlock Text="コピーしたものや撮ったスクリーンショットが、ここに入ります。クリックすると、作業中のアプリに貼り付けます。"
                 TextWrapping="Wrap" TextAlignment="Center" FontSize="12" LineHeight="18"
                 Foreground="{DynamicResource Hkd.TextSecondary}" />
    </StackPanel>
  </Grid>
</Window>
